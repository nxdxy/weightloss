# Database
DATABASE_URL=sqlite:///./fitness_pal.db
# For PostgreSQL: postgresql://username:password@localhost/fitness_pal

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes

# CORS
ALLOWED_ORIGINS=http://localhost:8888,http://localhost:5173,http://localhost:3000

# Development
DEBUG=True
